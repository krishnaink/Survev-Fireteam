<section class="zv-lb-hero">
  <div class="container zv-lb-hero-inner">
    <h1 class="zv-lb-title" data-l10n="index-leaderboards">Leaderboards</h1>
    <p class="zv-lb-lede" data-l10n="lb-best-runs">Highest rounds survived</p>
  </div>
</section>

<section class="zv-lb-controls">
  <div class="container">
    <div class="zv-lb-modes" role="tablist" aria-label="Game mode">
      <% for (var i = 0; i < env.modes.length; i++) { %>
        <% var m = env.modes[i]; %>
        <button type="button" class="zv-lb-mode zv-lb-mode--<%= m.key %>" data-mode="<%= m.key %>" role="tab">
          <span class="zv-lb-mode-name" data-l10n="index-mode-<%= m.key %>"><%= m.label %></span>
          <span class="zv-lb-mode-desc" data-l10n="lb-mode-desc-<%= m.key %>"><%= m.desc %></span>
        </button>
      <% } %>
    </div>
    <div class="zv-lb-filters">
      <div class="zv-lb-filter">
        <span class="zv-lb-filter-label" data-l10n="lb-team">Team</span>
        <div class="zv-seg" data-param="team" role="tablist" aria-label="Team size">
          <button type="button" data-value="solo" data-l10n="stats-solo">Solo</button>
          <button type="button" data-value="duo" data-l10n="stats-duo">Duo</button>
          <button type="button" data-value="squad" data-l10n="stats-squad">Squad</button>
        </div>
      </div>
      <div class="zv-lb-filter">
        <span class="zv-lb-filter-label" data-l10n="lb-window">Window</span>
        <div class="zv-seg" data-param="t" role="tablist" aria-label="Time window">
          <button type="button" data-value="daily" data-l10n="stats-today">Today</button>
          <button type="button" data-value="weekly" data-l10n="stats-this-week">This week</button>
          <button type="button" data-value="alltime" data-l10n="stats-all-time">All time</button>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="lb-board">
  <div class="container lb-board-inner">
    <div class="content"></div>
  </div>
</section>
