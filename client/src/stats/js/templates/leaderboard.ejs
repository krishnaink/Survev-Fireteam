<div class="lb-table-shell lb-clean-board">
  <table id="leaderboard-table" class="lb-table leaderboard-waves">
    <thead>
      <tr class="leaderboard-headers">
        <th scope="col" data-l10n="stats-rank">Rank</th>
        <th scope="col" data-l10n="<%= env.teamMode == 'solo' || env.teamMode == 1 ? 'stats-player' : 'index-leaderboard-col-fireteam' %>">Fireteam / player</th>
        <th scope="col" data-l10n="index-leaderboard-col-time">Rounds</th>
        <th scope="col" class="lb-secondary" data-l10n="index-leaderboard-col-difficulty">Difficulty</th>
        <th scope="col" class="lb-secondary" data-l10n="index-leaderboard-col-elapsed">Time</th>
        <th scope="col" class="lb-combat-cell" data-l10n="lb-kills" title="Kills during this ranked run">Kills</th>
        <th scope="col" class="lb-combat-cell" data-l10n="lb-downs" title="Times the operator was downed">Downs</th>
        <th scope="col" class="lb-combat-cell" data-l10n="lb-revives" title="Teammates revived during this ranked run">Revives</th>
      </tr>
    </thead>
    <tbody class="leaderboard-values">
      <% for (var i = 0; i < env.data.length; i++) { %>
        <% var row = env.data[i]; %>
        <% var members = row.memberStats || (row.members || []).map(function(name) { return { username: name }; }); %>
        <% var isTeam = !!row.fireteamName || !!(row.members && row.members.length); %>
        <% var name = env.leaderboardName(row); %>
        <% var diff = env.formatDifficulty(row.difficulty); %>
        <% var diffKey = ['recruit', 'regular', 'hardened', 'veteran'].includes((row.difficulty || '').toLowerCase()) ? row.difficulty.toLowerCase() : 'unknown'; %>
        <% var elapsed = row.time != null ? env.formatTime(row.time) : '—'; %>
        <tr class="main <%= isTeam ? 'is-team' : 'single-player' %> <%= i === 0 ? 'is-gold' : i === 1 ? 'is-silver' : i === 2 ? 'is-bronze' : '' %>">
          <td class="data-rank"><span class="lb-rank"><%= i + 1 %></span></td>
          <td class="data-player-names">
            <button type="button" class="lb-team-toggle" aria-expanded="false" aria-controls="lb-run-<%= i %>" title="Run details">
              <span class="lb-team-chevron" aria-hidden="true"></span>
              <span class="lb-team-name" title="<%= name %>"><%= name %></span>
            </button>
            <span class="lb-entry-meta"><% if (isTeam) { %><%= members.length %> <span data-l10n="<%= members.length === 1 ? 'lb-operator-singular' : 'lb-operators' %>">operators</span><% } else { %><span data-l10n="lb-individual">Individual entry</span><% } %></span>
          </td>
          <td class="data-rounds"><%= row.val > 0 ? row.val : '—' %></td>
          <td class="lb-secondary"><span class="lb-diff lb-diff-<%= diffKey %>"><%= diff %></span></td>
          <td class="lb-secondary"><%= elapsed %></td>
          <td class="lb-combat-cell"><%= env.leaderboardStat(row.kills) %></td>
          <td class="lb-combat-cell"><%= env.leaderboardStat(row.downs) %></td>
          <td class="lb-combat-cell"><%= env.leaderboardStat(row.revives) %></td>
        </tr>
        <tr id="lb-run-<%= i %>" class="lb-run-details" hidden>
          <td colspan="8">
            <div class="lb-run-content">
              <p class="lb-run-caption" data-l10n="<%= isTeam ? 'lb-team-totals' : 'lb-run-stats' %>">Ranked run stats</p>
              <div class="lb-mobile-metrics">
                <span><span data-l10n="index-leaderboard-col-difficulty">Difficulty</span><strong><%= diff %></strong></span>
                <span><span data-l10n="index-leaderboard-col-elapsed">Time</span><strong><%= elapsed %></strong></span>
                <% for (var stat of ['kills', 'downs', 'revives']) { %>
                  <span><span data-l10n="lb-<%= stat %>"><%= stat %></span><strong><%= env.leaderboardStat(row[stat]) %></strong></span>
                <% } %>
              </div>
              <p class="lb-run-metadata"><%= row.region ? row.region.toUpperCase() : '—' %> · <%= row.version ? 'v' + row.version : '—' %> · <span data-l10n="stats-submitted">Submitted</span> <%= env.formatSubmittedAt(row.submittedAt) %></p>
              <% if (members.length) { %>
                <table class="lb-member-table" aria-label="Operator contributions">
                  <thead><tr><th scope="col" data-l10n="lb-operator">Operator</th><th scope="col" data-l10n="lb-kills">Kills</th><th scope="col" data-l10n="lb-downs">Downs</th><th scope="col" data-l10n="lb-revives">Revives</th></tr></thead>
                  <tbody><% for (var member of members) { %>
                    <tr><th scope="row"><%= member.username %></th><td><%= env.leaderboardStat(member.kills) %></td><td><%= env.leaderboardStat(member.downs) %></td><td><%= env.leaderboardStat(member.revives) %></td></tr>
                  <% } %></tbody>
                </table>
              <% } %>
              <p class="lb-run-caption" data-l10n="lb-missing-stats">— = not recorded</p>
            </div>
          </td>
        </tr>
      <% } %>
      <% if (!env.data.length) { %><tr><td colspan="8" class="lb-empty">No runs found for these filters.</td></tr><% } %>
    </tbody>
  </table>
</div>
<p class="lb-board-footnote" data-l10n="lb-run-metrics">Stats shown are from the ranked run. Downs = times downed.</p>
